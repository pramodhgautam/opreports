# ---------------------------------------------------------------------------
# Operations Reporting Portal - backend environment
# Copy to `.env` and fill in real values. All of these are required at boot.
# ---------------------------------------------------------------------------

# Keycloak Identity Provider (issuer = realm root, no trailing slash)
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/opreports

# Angular SPA client id (used by the frontend; kept here for consistency)
KEYCLOAK_CLIENT_ID=opreports-spa

# Expected `aud` claim value. Must match the Keycloak Audience mapper
# (Clients -> <spa-client> -> Client scopes -> <client>-dedicated -> Mappers ->
#  Add mapper -> By configuration -> Audience -> "Included Custom Audience").
OIDC_AUDIENCE=opreports-api

# PostgreSQL connection string (database name = opreports)
DATABASE_URL=postgresql://opreports_app:<password>@localhost:5432/opreports

# Allowed browser origin for CORS (no trailing slash)
CORS_ORIGIN=http://localhost:4200

# HTTP port (defaults to 3000)
PORT=3000
